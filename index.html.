<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Hand Hub デモ QRコード</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
  :root {
    --bg: #F5F6F3;
    --card: #FFFFFF;
    --ink: #1C1F26;
    --navy: #16213E;
    --steel: #6B7280;
    --line: #E4E7EC;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #14161A;
      --card: #1E2127;
      --ink: #F2F3F5;
      --navy: #E9EDFF;
      --steel: #9AA1AC;
      --line: #2B2F36;
    }
  }
  :root[data-theme="dark"] {
    --bg: #14161A;
    --card: #1E2127;
    --ink: #F2F3F5;
    --navy: #E9EDFF;
    --steel: #9AA1AC;
    --line: #2B2F36;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; height: 100%;
    background: var(--bg); color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .wrap {
    min-height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 32px 20px;
    text-align: center;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 28px;
    max-width: 360px;
    width: 100%;
  }
  h1 {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 4px;
  }
  p.sub {
    font-size: 13px;
    color: var(--steel);
    margin: 0 0 20px;
  }
  #qrcode {
    display: flex;
    justify-content: center;
    margin: 0 auto 16px;
    background: white;
    padding: 12px;
    border-radius: 12px;
    width: fit-content;
  }
  .url {
    font-size: 11px;
    color: var(--steel);
    word-break: break-all;
    margin-top: 8px;
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="card">
    <h1>Hand Hub（デモ版）</h1>
    <p class="sub">スマホのカメラで読み取ってください</p>
    <div id="qrcode"></div>
    <div class="url">https://claude.ai/artifact/Ag9v1kPUxqmnon3StTH56j</div>
  </div>
</div>
<script>
  new QRCode(document.getElementById("qrcode"), {
    text: "https://claude.ai/artifact/Ag9v1kPUxqmnon3StTH56j",
    width: 220,
    height: 220,
    colorDark: "#16213E",
    colorLight: "#ffffff",
    correctLevel: QRCode.CorrectLevel.M
  });
</script>
</body>
</html>
